# =========================================================
#  MalGuard — sozlamalar namunasi
#  Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring:
#      cp .env.example .env
# =========================================================

# ---------- Django ----------
SECRET_KEY=bu-yerga-uzun-tasodifiy-maxfiy-kalit-yozing
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production HTTPS domeni (webhook/forma uchun), masalan: https://domen.uz
CSRF_TRUSTED_ORIGINS=

# Sayt manzili (botdagi "Batafsil" tugmasi shu manzilga ishora qiladi)
SITE_URL=http://localhost:8000

# ---------- Ma'lumotlar bazasi ----------
# Standart: sqlite (hech narsa sozlamasdan ishlaydi).
# PostgreSQL uchun: DB_ENGINE=postgres va quyidagilarni to'ldiring.
DB_ENGINE=sqlite
DB_NAME=malguard_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------- API kalitlari ----------
# Kamida bittasi bo'lsa ishlaydi. Bo'sh qoldirilgan xizmat o'tkazib yuboriladi.
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# Hybrid Analysis: https://www.hybrid-analysis.com/my-account?tab=api-key-tab
HYBRID_ANALYSIS_API_KEY=
# MalwareBazaar (abuse.ch): https://auth.abuse.ch/
MALWAREBAZAAR_API_KEY=

# So'rov uchun timeout (soniya) va VirusTotal yangi fayl tahlilini kutish vaqti
SCAN_HTTP_TIMEOUT=30
VT_POLL_TIMEOUT=90

# ---------- Telegram bot ----------
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=
# Bot username (@ belgisisiz), masalan: malguardbot
TELEGRAM_BOT_USERNAME=your_bot
# Webhook (faqat HTTPS public domen bo'lsa). Polling uchun bo'sh qoldiring.
TELEGRAM_WEBHOOK_URL=
# Webhook uchun ixtiyoriy maxfiy token (xavfsizlik uchun tavsiya etiladi)
TELEGRAM_WEBHOOK_SECRET=

# ---------- Fayl yuklash ----------
MAX_UPLOAD_SIZE_MB=32

# ---------- Vaqt mintaqasi ----------
TIME_ZONE=Asia/Tashkent
